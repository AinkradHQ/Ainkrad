skill-observations/
docs/superpowers/

# Release build output
dist/

# Local xcodebuild output directory (see Makefile)
build/

.superpowers/

# Developer ID provisioning profile consumed by scripts/release.sh — pulled
# from the Apple Developer portal, not source.
config/*.provisionprofile
