# design-lint baseline. Counts only go down: `make lint` lowers them.
# Raising one needs `make lint-rebaseline`, DESIGN_LINT_ALLOW_RAISE=1 on push, and a PR note.
version 1
format off
font-size 26
padding-literal 60
spacing-literal 94
radius-literal 7
hex-color 6
raw-color 1
raw-control 12
file-length 3
try-bang 0
force-cast 0
force-unwrap 19
print 0
opacity-literal 157
frame-literal 64
chamfer-literal 9
motion-literal 1
