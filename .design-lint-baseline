# design-lint baseline. Counts only go down: `make lint` lowers them.
# Raising one needs `make lint-rebaseline`, DESIGN_LINT_ALLOW_RAISE=1 on push, and a PR note.
version 1
format off
font-size 2
padding-literal 8
spacing-literal 25
radius-literal 3
hex-color 3
raw-color 1
raw-control 1
file-length 3
try-bang 0
force-cast 0
force-unwrap 17
print 0
opacity-literal 34
frame-literal 37
chamfer-literal 0
motion-literal 1
