# design-lint baseline. Counts only go down: `make lint` lowers them.
# Raising one needs `make lint-rebaseline`, DESIGN_LINT_ALLOW_RAISE=1 on push, and a PR note.
version 1
format off
font-size 126
padding-literal 230
spacing-literal 286
radius-literal 48
hex-color 10
raw-color 18
raw-control 85
file-length 15
try-bang 0
force-cast 0
force-unwrap 30
print 0
opacity-literal 570
frame-literal 166
chamfer-literal 57
motion-literal 59
