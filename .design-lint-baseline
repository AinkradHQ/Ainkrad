# design-lint baseline. Counts only go down: `make lint` lowers them.
# Raising one needs `make lint-rebaseline`, DESIGN_LINT_ALLOW_RAISE=1 on push, and a PR note.
version 1
format off
font-size 41
padding-literal 66
spacing-literal 108
radius-literal 7
hex-color 6
raw-color 1
raw-control 23
file-length 3
try-bang 0
force-cast 0
force-unwrap 19
print 0
opacity-literal 216
frame-literal 80
chamfer-literal 30
motion-literal 19
