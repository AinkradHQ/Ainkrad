# design-lint baseline. Counts only go down: `make lint` lowers them.
# Raising one needs `make lint-rebaseline`, DESIGN_LINT_ALLOW_RAISE=1 on push, and a PR note.
version 1
format off
font-size 111
padding-literal 157
spacing-literal 244
radius-literal 22
hex-color 9
raw-color 10
raw-control 63
file-length 8
try-bang 0
force-cast 0
force-unwrap 26
print 0
opacity-literal 421
frame-literal 124
chamfer-literal 53
motion-literal 33
