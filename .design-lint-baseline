# design-lint baseline. Counts only go down: `make lint` lowers them.
# Raising one needs `make lint-rebaseline`, DESIGN_LINT_ALLOW_RAISE=1 on push, and a PR note.
version 1
format off
font-size 113
padding-literal 180
spacing-literal 255
radius-literal 29
hex-color 9
raw-color 16
raw-control 66
file-length 8
try-bang 0
force-cast 0
force-unwrap 26
print 0
opacity-literal 463
frame-literal 131
chamfer-literal 53
motion-literal 42
