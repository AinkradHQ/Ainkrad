# design-lint baseline. Counts only go down: `make lint` lowers them.
# Raising one needs `make lint-rebaseline`, DESIGN_LINT_ALLOW_RAISE=1 on push, and a PR note.
version 1
format off
font-size 43
padding-literal 67
spacing-literal 109
radius-literal 7
hex-color 6
raw-color 1
raw-control 29
file-length 4
try-bang 0
force-cast 0
force-unwrap 24
print 0
opacity-literal 221
frame-literal 85
chamfer-literal 32
motion-literal 20
