# design-lint baseline. Counts only go down: `make lint` lowers them.
# Raising one needs `make lint-rebaseline`, DESIGN_LINT_ALLOW_RAISE=1 on push, and a PR note.
version 1
format off
font-size 124
padding-literal 229
spacing-literal 285
radius-literal 48
hex-color 10
raw-color 18
raw-control 79
file-length 11
try-bang 0
force-cast 0
force-unwrap 26
print 0
opacity-literal 565
frame-literal 164
chamfer-literal 57
motion-literal 59
