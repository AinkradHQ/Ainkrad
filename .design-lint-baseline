# design-lint baseline. Counts only go down: `make lint` lowers them.
# Raising one needs `make lint-rebaseline`, DESIGN_LINT_ALLOW_RAISE=1 on push, and a PR note.
version 1
format off
font-size 17
padding-literal 50
spacing-literal 86
radius-literal 7
hex-color 6
raw-color 1
raw-control 1
file-length 3
try-bang 0
force-cast 0
force-unwrap 17
print 0
opacity-literal 133
frame-literal 63
chamfer-literal 5
motion-literal 1
