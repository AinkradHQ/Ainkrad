# design-lint baseline. Counts only go down: `make lint` lowers them.
# Raising one needs `make lint-rebaseline`, DESIGN_LINT_ALLOW_RAISE=1 on push, and a PR note.
version 1
format off
font-size 90
padding-literal 123
spacing-literal 212
radius-literal 19
hex-color 8
raw-color 8
raw-control 41
file-length 8
try-bang 0
force-cast 0
force-unwrap 24
print 0
opacity-literal 352
frame-literal 105
chamfer-literal 36
motion-literal 29
