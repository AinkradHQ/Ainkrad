# design-lint baseline. Counts only go down: `make lint` lowers them.
# Raising one needs `make lint-rebaseline`, DESIGN_LINT_ALLOW_RAISE=1 on push, and a PR note.
version 1
format off
font-size 96
padding-literal 129
spacing-literal 233
radius-literal 21
hex-color 9
raw-color 9
raw-control 45
file-length 8
try-bang 0
force-cast 0
force-unwrap 26
print 0
opacity-literal 380
frame-literal 110
chamfer-literal 42
motion-literal 30
